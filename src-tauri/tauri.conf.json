{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CacaoFacturador",
  "version": "1.0.0",
  "identifier": "com.cacaoapps.facturador",
  "build": {
    "frontendDist": "../src/web/static"
  },
  "app": {
    "windows": [
      {
        "title": "Cacao Facturador SRI - Ecuador (Rust Desktop)",
        "width": 1150,
        "height": 800,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
