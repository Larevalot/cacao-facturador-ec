{
  "name": "cacaofacturador-ec",
  "version": "1.0.0",
  "description": "Facturador Electrónico SRI Ecuador en Rust y Tauri v2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:ui": "vite build",
    "serve": "pnpm build:ui && cargo run -- --serve",
    "desktop": "pnpm build:ui && GDK_BACKEND=x11 WEBKIT_DISABLE_COMPOSITING_MODE=1 tauri dev",
    "desktop:build": "pnpm build:ui && GDK_BACKEND=x11 tauri build",
    "build": "pnpm build:ui && cargo build --release",
    "test": "cargo test",
    "cli": "cargo run -- --cli"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tauri-apps/cli": "^2.11.4",
    "svelte": "^5.56.8",
    "vite": "^8.2.1"
  },
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1"
  }
}
